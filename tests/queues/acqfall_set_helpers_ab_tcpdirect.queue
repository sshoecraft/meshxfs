370 ARMED_S=180 EXPECT=bounded WORKLOAD=held_fd_mmap_read tests/tcp_lockreq_blackhole.sh acqshf_mmr test32 test31
460 ARMED_S=180 EXPECT=bounded WORKLOAD=dir_rename tests/tcp_lockreq_blackhole.sh acqshf_ren test32 test31
460 ARMED_S=180 EXPECT=bounded WORKLOAD=dir_link tests/tcp_lockreq_blackhole.sh acqshf_lnk test32 test31
460 ARMED_S=180 EXPECT=bounded WORKLOAD=dir_lookup tests/tcp_lockreq_blackhole.sh acqshf_lkp test32 test31
460 ARMED_S=180 EXPECT=bounded WORKLOAD=held_dir_readdir tests/tcp_lockreq_blackhole.sh acqshf_rdd test32 test31
460 ARMED_S=180 EXPECT=bounded WORKLOAD=leaf_midlist tests/tcp_lockreq_blackhole.sh acqshf_lml test32 test31
60 tests/fleet_set_params.sh "acqfall_unowed_skip acqfall_unowed_skip_n close_release" test31,test32 tests/evidence/acqsh_f_after.txt
465 MXFS_CONFIG_LOCK_WAIT_S=150 ./run.sh 2/net/mesh/direct --group g2d chk_clean
