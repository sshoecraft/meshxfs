# rs 15 + evidence rs 130 + 60 + 180 + cold audit 240 = 1826 s.
1830 tests/noqueue_unanswered_ab.sh nquc1 0 3/net/mesh/direct g3b
1830 tests/noqueue_unanswered_ab.sh nquf1 1 3/net/mesh/direct g3b
