+/*
+ * +caw-abort-reclaim.6: abort the commands of every session of the
+ * registrant's I_T nexus on this device other than reg->tgt_dev's.
+ *
+ * scst_pr_init_tgt_dev() hands the registrant to a new session of the nexus
+ * while an earlier one is still shutting down, and that earlier session may
+ * still hold commands it admitted while it held the registrant.  PREEMPT AND
+ * ABORT guarantees that no command of the preempted nexus completes after the
+ * PR command does, so those must be aborted too.
+ *
+ * Must be called under dev_pr_mutex.  A tgt_dev leaves dev_tgt_dev_list only
+ * in scst_free_session(), after its session's refcount reached zero, so every
+ * session of the nexus that still holds a command is on the list.  A tgt_dev
+ * added to the list after the count below belongs to a session that has sent
+ * no command to this device yet (scst_pr_init_tgt_dev() precedes the list add
+ * and waits for dev_pr_mutex), so it holds nothing to abort.
+ */
+static void scst_pr_abort_nexus_sessions(struct scst_device *dev,
+					 struct scst_cmd *pr_cmd,
+					 struct scst_dev_registrant *reg)
+{
+	struct scst_tgt_dev *t;
+	struct scst_session **sessions;
+	uint64_t *luns;
+	int count = 0, n = 0, i, rc;
+
+	spin_lock_bh(&dev->dev_lock);
+	list_for_each_entry(t, &dev->dev_tgt_dev_list, dev_tgt_dev_list_entry) {
+		if (t != reg->tgt_dev && t->sess->transport_id &&
+		    t->sess->tgt->rel_tgt_id == reg->rel_tgt_id &&
+		    tid_equal(t->sess->transport_id, reg->transport_id))
+			count++;
+	}
+	spin_unlock_bh(&dev->dev_lock);
+
+	if (count == 0)
+		return;
+
+	sessions = kmalloc_array(count, sizeof(*sessions), GFP_KERNEL | __GFP_NOFAIL);
+	luns = kmalloc_array(count, sizeof(*luns), GFP_KERNEL | __GFP_NOFAIL);
+
+	spin_lock_bh(&dev->dev_lock);
+	list_for_each_entry(t, &dev->dev_tgt_dev_list, dev_tgt_dev_list_entry) {
+		if (n == count)
+			break;
+		if (t == reg->tgt_dev || !t->sess->transport_id ||
+		    t->sess->tgt->rel_tgt_id != reg->rel_tgt_id ||
+		    !tid_equal(t->sess->transport_id, reg->transport_id))
+			continue;
+		/* Zero: every command of that session has been released. */
+		if (!percpu_ref_tryget(&t->sess->refcnt))
+			continue;
+		sessions[n] = t->sess;
+		luns[n] = t->lun;
+		n++;
+	}
+	spin_unlock_bh(&dev->dev_lock);
+
+	for (i = 0; i < n; i++) {
+		__be64 packed_lun = scst_pack_lun(luns[i], sessions[i]->acg->addr_method);
+
+		PRINT_INFO("PR ABORT: registrant %s/%d (key 0x%016llx) earlier session %p of the nexus (shut_phase %ld): aborting its commands",
+			   debug_transport_id_to_initiator_name(reg->transport_id),
+			   reg->rel_tgt_id, be64_to_cpu(reg->key), sessions[i],
+			   sessions[i]->shut_phase);
+		rc = scst_rx_mgmt_fn_lun(sessions[i], SCST_PR_ABORT_ALL, &packed_lun,
+					 sizeof(packed_lun), SCST_NON_ATOMIC, pr_cmd);
+		percpu_ref_put(&sessions[i]->refcnt);
+		if (rc != 0)
+			PRINT_ERROR("SCST_PR_ABORT_ALL failed %d (earlier sess %p of the nexus)",
+				    rc, sessions[i]);
+	}
+
+	kfree(luns);
+	kfree(sessions);
+}
+
 /* Must be called under dev_pr_mutex */
 static void scst_pr_abort_reg(struct scst_device *dev, struct scst_cmd *pr_cmd,
 			      struct scst_dev_registrant *reg)
@@ -566,6 +643,8 @@
 
 	scst_assert_pr_mutex_held(dev);
 
+	scst_pr_abort_nexus_sessions(dev, pr_cmd, reg);
+
 	if (!reg->tgt_dev) {
 		TRACE_PR("Registrant %s/%d (%p, key 0x%016llx) has no session",
 			 debug_transport_id_to_initiator_name(reg->transport_id),
@@ -1191,7 +1270,30 @@
 	scst_pr_write_lock(dev);
 
 	reg = scst_pr_find_reg(dev, transport_id, rel_tgt_id);
-	if (reg && !reg->tgt_dev) {
+	if (reg && reg->tgt_dev && reg->tgt_dev != tgt_dev &&
+	    READ_ONCE(reg->tgt_dev->sess->shut_phase) != SCST_SESS_SPH_READY) {
+		/*
+		 * +caw-abort-reclaim.6: the registrant is still linked to the
+		 * per-device state of an earlier session of this I_T nexus, and
+		 * that session is already shutting down: it is freed (and the
+		 * registrant moved by scst_pr_clear_tgt_dev()) only once its
+		 * refcount drops, on the management thread.  A registration
+		 * belongs to the nexus and survives its loss, so the new session
+		 * is the nexus now: take the registrant, or every command it sends
+		 * until that free is refused RESERVATION CONFLICT although the
+		 * nexus is registered.  The earlier session's commands still in
+		 * flight are reached by PREEMPT AND ABORT through
+		 * scst_pr_abort_nexus_sessions().
+		 */
+		PRINT_INFO("PR: moving reg %s/%d (%p, key 0x%016llx) from shutting-down sess %p (tgt_dev %p) to new tgt_dev %p (dev %s)",
+			   debug_transport_id_to_initiator_name(transport_id),
+			   rel_tgt_id, reg, be64_to_cpu(reg->key),
+			   reg->tgt_dev->sess, reg->tgt_dev, tgt_dev,
+			   dev->virt_name);
+		reg->tgt_dev->registrant = NULL;
+		tgt_dev->registrant = reg;
+		reg->tgt_dev = tgt_dev;
+	} else if (reg && !reg->tgt_dev) {
 		TRACE_PR("Assigning reg %s/%d (%p) to tgt_dev %p (dev %s)",
 			 debug_transport_id_to_initiator_name(transport_id),
 			 rel_tgt_id, reg, tgt_dev, dev->virt_name);
